name = "travelos-data"
main = "src/index.js"
compatibility_date = "2026-09-29"

[[d1_databases]]
binding = "DB"
database_name = "travelos"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
ALLOWED_ORIGINS = "https://kyuu2601-star.github.io"
MAP_WORKER_URL = "https://travelos-map.kyuu2601.workers.dev"

[[services]]
binding = "MAP_WORKER"
service = "travelos-map"
